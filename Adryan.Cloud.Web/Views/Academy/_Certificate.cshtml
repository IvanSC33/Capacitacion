        <button class="btn btn-success" onclick="window.print()"><i class="fas fa-print me-2"></i> Imprimir / PDF</button>
    </div>
    
    <div class="adr-certificate mx-auto" style="max-width: 900px;" id="adr-cert-print-area">
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3" style="width: 80px; height: 80px;">

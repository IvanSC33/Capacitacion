<section id="adr-course-view" class="adr-view-section">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <button class="btn btn-outline-secondary btn-sm rounded-pill" onclick="ADRYAN.UI.navigate('adr-module-view')">
            <i class="fas fa-arrow-left me-2"></i> Volver al Módulo
        </button>
        <h5 class="fw-bold mb-0" id="adr-viewer-title">Título del Curso</h5>
        <button class="btn adr-btn-primary btn-sm rounded-pill px-4" id="adr-btn-complete-course" onclick="ADRYAN.LMS.markCourseComplete()">
            <i class="fas fa-check me-2"></i> Marcar como Completado
        </button>
    </div>

    <!-- Contenedor del Simulador -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="min-height: 700px; background: #2b3035;">
        <div class="card-header bg-dark text-white border-0 py-3 d-flex align-items-center">
            <i class="fas fa-laptop-code me-3 text-info"></i> <span class="font-monospace small">ADRYAN Interactive Environment</span>
        </div>
        <div class="card-body bg-light p-0 d-flex align-items-center justify-content-center" id="adr-viewer-content">
            <!-- El iframe irá aquí dinámicamente -->
        </div>
    </div>
</section>
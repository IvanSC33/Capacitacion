<section id="adr-module-view" class="adr-view-section">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="javascript:void(0)" onclick="ADRYAN.UI.navigate('adr-dashboard')" class="text-primary text-decoration-none">Inicio</a></li>
            <li class="breadcrumb-item active fw-bold text-dark" id="adr-breadcrumb-current">Módulo Actual</li>
        </ol>
    </nav>

    <div id="adr-module-header" class="mb-5 bg-white p-4 rounded-4 shadow-sm border">
        <!-- Dinámico -->
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <h5 class="fw-bold mb-3 text-dark">Contenido del Módulo</h5>
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-body p-0" id="adr-courses-list">
                    <!-- Dinámico -->
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(145deg, #ffffff, #f4f5f7);">
                <div class="card-body text-center p-5">
                    <i class="fas fa-certificate text-muted opacity-20 mb-3" style="font-size: 5rem;"></i>
                    <h5 class="fw-bold text-dark">Certificado ADRYAN</h5>
                    <p class="small text-muted mb-4">Completa el 100% para obtenerlo.</p>
                    
                    <div class="progress mb-3" style="height: 8px;">
                        <div id="adr-cert-progress-bar" class="progress-bar bg-primary" style="width: 0%"></div>
                    </div>
                    <button class="btn btn-light w-100 fw-bold disabled" id="adr-btn-cert" onclick="ADRYAN.LMS.generateCertificate()">Obtener Certificado</button>
                </div>
            </div>
        </div>
    </div>
</section>
